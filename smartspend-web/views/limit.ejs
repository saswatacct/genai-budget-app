<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Monthly Spending Limit</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            font-family: 'Poppins', sans-serif;

            background:
                linear-gradient(
                    rgba(0, 0, 0, 0.65),
                    rgba(0, 0, 0, 0.75)
                ),
                url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?q=80&w=2070&auto=format&fit=crop');

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;

            min-height: 100vh;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            padding: 20px;
        }

        .limit-card {

            width: 100%;
            max-width: 520px;

            background: rgba(255, 255, 255, 0.12);

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            border: 1px solid rgba(255,255,255,0.18);

            border-radius: 24px;

            padding: 40px;

            box-shadow:
                0 8px 32px rgba(0,0,0,0.35);

            color: white;

            transition: 0.35s ease;
        }

        .limit-card:hover {

            transform: translateY(-5px);

            box-shadow:
                0 14px 40px rgba(0,0,0,0.45);
        }

        .page-title {

            font-size: 38px;

            font-weight: 700;

            text-align: center;

            margin-bottom: 10px;
        }

        .subtitle {

            text-align: center;

            margin-bottom: 35px;

            color: #e5e7eb;

            font-size: 15px;
        }

        .form-control {

            height: 55px;

            border-radius: 14px;

            border: none;

            padding-left: 16px;

            font-size: 15px;

            margin-bottom: 18px;
        }

        .form-control:focus {

            box-shadow: 0 0 0 0.2rem rgba(79,124,255,0.35);
        }

        .form-check {

            margin-bottom: 16px;
        }

        .form-check-label {

            color: #f1f5f9;

            font-size: 15px;
        }

        .form-check-input {

            transform: scale(1.1);

            margin-right: 8px;
        }

        .btn-save {

            height: 55px;

            border-radius: 14px;

            font-weight: 600;

            font-size: 16px;

            border: none;

            background: linear-gradient(
                135deg,
                #4f7cff,
                #2458ff
            );

            transition: 0.3s ease;
        }

        .btn-save:hover {

            transform: translateY(-2px);

            background: linear-gradient(
                135deg,
                #2458ff,
                #4f7cff
            );
        }

        footer {

            margin-top: 30px;

            text-align: center;

            color: #f0f0f0;

            font-size: 14px;

            line-height: 1.8;
        }

        @media(max-width: 576px) {

            .limit-card {

                padding: 30px 22px;
            }

            .page-title {

                font-size: 30px;
            }
        }

    </style>

</head>

<body>

    <div class="limit-card">

        <div class="page-title">
            Monthly Spending Limit
        </div>

        <div class="subtitle">
            Configure your UPI and Credit Card transaction limits securely
        </div>

        <form method="POST" action="/limit">

            <input
                type="number"
                name="upi_limit"
                class="form-control"
                placeholder="UPI Limit"
                required
            >

            <input
                type="number"
                name="credit_limit"
                class="form-control"
                placeholder="Credit Card Limit"
                required
            >

            <input
                type="text"
                name="card_no"
                class="form-control"
                placeholder="Masked Card Number"
                required
            >

            <input
                type="text"
                name="account_no"
                class="form-control"
                placeholder="Masked Account Number"
                required
            >

            <div class="form-check">

                <input
                    class="form-check-input"
                    type="checkbox"
                    name="atm_enabled"
                    checked
                >

                <label class="form-check-label">
                    ATM Enabled
                </label>

            </div>

            <div class="form-check mb-4">

                <input
                    class="form-check-input"
                    type="checkbox"
                    name="online_enabled"
                    checked
                >

                <label class="form-check-label">
                    Online Transactions Enabled
                </label>

            </div>

            <button class="btn btn-primary btn-save w-100">
                Save Limit
            </button>

        </form>

    </div>

    <footer>

        <div>
            Developed by Saswat Mohapatra
        </div>

        <div>
            Please give your feedback at feedback_saswat@gmail.com
        </div>

    </footer>

</body>

</html>