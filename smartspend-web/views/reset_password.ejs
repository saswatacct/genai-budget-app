<!DOCTYPE html>

<html>

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width,initial-scale=1"
>

<title>

Reset Password

</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap"
rel="stylesheet"
>

<style>

body{

font-family:
'Poppins',
sans-serif;

background:

linear-gradient(
rgba(0,0,0,.65),
rgba(0,0,0,.75)
),

url(
'https://images.unsplash.com/photo-1554224155-6726b3ff858f'
);

background-size:cover;

min-height:100vh;

display:flex;

justify-content:center;

align-items:center;

padding:20px;

}

.card-box{

background:

rgba(
255,
255,
255,
0.10
);

backdrop-filter:
blur(14px);

padding:40px;

border-radius:24px;

width:400px;

color:white;

box-shadow:

0 8px 32px

rgba(
0,
0,
0,
0.35
);

}

input{

height:52px;

border-radius:12px;

}

button{

height:52px;

border-radius:12px;

font-weight:600;

}

</style>

</head>

<body>

<div
class="card-box"
>

<h2
class="mb-3"
>

Reset Password

</h2>

<form

method="POST"

action="/reset-password"

>

<input

type="hidden"

name="token"

value="<%= token %>"

>

<input

type="password"

name="password"

class="form-control"

placeholder="Enter New Password"

required

>

<button

class="
btn
btn-primary
w-100
mt-3
"

>

Update Password

</button>

</form>

</div>

</body>

</html>