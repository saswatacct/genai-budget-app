<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SmartSpend AI Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            font-family: 'Poppins', sans-serif;

            background:
                linear-gradient(
                    rgba(0, 0, 0, 0.70),
                    rgba(0, 0, 0, 0.75)
                ),
                url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?q=80&w=2070&auto=format&fit=crop');

            background-size: cover;
            background-position: center;
            background-attachment: fixed;

            min-height: 100vh;

            color: white;
        }

        .navbar-custom {

            background: rgba(255,255,255,0.10);

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            border: 1px solid rgba(255,255,255,0.18);

            border-radius: 24px;

            padding: 25px 30px;

            margin-top: 25px;

            box-shadow:
                0 8px 32px rgba(0,0,0,0.35);
        }

        .dashboard-title {

            font-size: 42px;

            font-weight: 700;

            margin-bottom: 5px;
        }

        .dashboard-subtitle {

            color: #dbe3f0;

            font-size: 16px;
        }

        .glass-card {

            background: rgba(255,255,255,0.10);

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            border: 1px solid rgba(255,255,255,0.15);

            border-radius: 24px;

            padding: 30px;

            box-shadow:
                0 8px 32px rgba(0,0,0,0.30);

            transition: 0.35s ease;

            height: 100%;
        }

        .glass-card:hover {

            transform: translateY(-6px);

            box-shadow:
                0 14px 40px rgba(0,0,0,0.45);
        }

        .card-icon {

            font-size: 42px;

            margin-bottom: 18px;

            color: #76a9ff;
        }

        .card-title {

            font-size: 24px;

            font-weight: 600;

            margin-bottom: 12px;
        }

        .card-desc {

            color: #d1d5db;

            margin-bottom: 24px;

            line-height: 1.7;
        }

        .custom-btn {

            border-radius: 14px;

            font-weight: 600;

            padding: 12px 22px;

            border: none;

            transition: 0.3s ease;
        }

        .custom-btn:hover {

            transform: scale(1.02);
        }

        .btn-blue {

            background: linear-gradient(
                135deg,
                #4f7cff,
                #2458ff
            );

            color: white;
        }

        .btn-green {

            background: linear-gradient(
                135deg,
                #34c759,
                #1e9e44
            );

            color: white;
        }

        .btn-darkglass {

            background: rgba(0,0,0,0.35);

            color: white;
        }

        .btn-logout {

            background: linear-gradient(
                135deg,
                #ff5f6d,
                #d64550
            );

            color: white;

            border-radius: 14px;

            padding: 12px 24px;

            font-weight: 600;

            border: none;
        }

        .btn-logout:hover {

            transform: translateY(-2px);
        }

        .info-list li {

            margin-bottom: 12px;

            color: #f1f5f9;
        }

        .badge-custom {

            padding: 10px 14px;

            border-radius: 10px;

            font-size: 13px;

            margin-right: 8px;
        }

        footer {

            margin-top: 60px;

            text-align: center;

            color: #f0f0f0;

            font-size: 14px;

            line-height: 1.8;

            padding-bottom: 25px;
        }

        @media(max-width: 768px) {

            .dashboard-title {

                font-size: 32px;
            }

            .navbar-custom {

                flex-direction: column;

                gap: 20px;

                text-align: center;
            }
        }

    </style>

</head>

<body>

    <div class="container py-4">

        <div class="navbar-custom d-flex justify-content-between align-items-center">

            <div>

                <div class="dashboard-title">
                    SmartSpend AI
                </div>

                <div class="dashboard-subtitle">
                    AI Powered Financial Management System
                </div>

            </div>

            <a href="/logout" class="btn btn-logout">
                Logout
            </a>

        </div>

        <div class="row mt-5 g-4">

            <div class="col-md-4">

                <div class="glass-card">

                    <div class="card-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>

                    <div class="card-title">
                        Set Spending Limit
                    </div>

                    <div class="card-desc">
                        Configure monthly UPI and credit card spending limits easily.
                    </div>

                    <a href="/limit" class="btn btn-blue custom-btn w-100">
                        Open
                    </a>

                </div>

            </div>

            <div class="col-md-4">

                <div class="glass-card">

                    <div class="card-icon">
                        <i class="bi bi-credit-card"></i>
                    </div>

                    <div class="card-title">
                        Add Transaction
                    </div>

                    <div class="card-desc">
                        Add expenses and receive AI-powered spending suggestions.
                    </div>

                    <a href="/transaction" class="btn btn-green custom-btn w-100">
                        Open
                    </a>

                </div>

            </div>

            <div class="col-md-4">

                <div class="glass-card">

                    <div class="card-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div class="card-title">
                        Transaction History
                    </div>

                    <div class="card-desc">
                        View and manage your complete monthly transaction history.
                    </div>

                    <a href="/history" class="btn btn-darkglass custom-btn w-100">
                        Open
                    </a>

                </div>

            </div>

        </div>

        <div class="row mt-5 g-4">

            <div class="col-md-6">

                <div class="glass-card">

                    <h3 class="mb-4">
                        Why SmartSpend AI?
                    </h3>

                    <ul class="info-list">

                        <li>AI Powered Budget Suggestions</li>

                        <li>WhatsApp Financial Alerts</li>

                        <li>Monthly Billing Cycle Tracking</li>

                        <li>Duplicate Transaction Protection</li>

                        <li>Fintech Style Expense Monitoring</li>

                    </ul>

                </div>

            </div>

            <div class="col-md-6">

                <div class="glass-card">

                    <h3 class="mb-4">
                        Smart AI Insights
                    </h3>

                    <p class="card-desc">

                        SmartSpend AI continuously monitors your spending patterns and provides intelligent financial recommendations to help you stay within your monthly budget.

                    </p>

                    <div class="mt-4">

                        <span class="badge bg-primary badge-custom">
                            AI Powered
                        </span>

                        <span class="badge bg-success badge-custom">
                            WhatsApp Alerts
                        </span>

                        <span class="badge bg-warning text-dark badge-custom">
                            Budget Tracking
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <footer>

            <div>
                Developed by Saswat Mohapatra
            </div>

            <div>
                Please give your feedback at feedback_saswat@gmail.com
            </div>

        </footer>

    </div>

</body>

</html>