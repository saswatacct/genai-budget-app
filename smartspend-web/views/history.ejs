<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Transaction History</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            font-family: 'Poppins', sans-serif;

            background:
                linear-gradient(
                    rgba(0, 0, 0, 0.65),
                    rgba(0, 0, 0, 0.75)
                ),
                url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?q=80&w=2070&auto=format&fit=crop');

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;

            min-height: 100vh;

            color: white;

            padding: 30px 15px;
        }

        .history-card {

            background: rgba(255,255,255,0.10);

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            border: 1px solid rgba(255,255,255,0.18);

            border-radius: 24px;

            padding: 35px;

            box-shadow:
                0 8px 32px rgba(0,0,0,0.35);

            transition: 0.35s ease;
        }

        .history-card:hover {

            transform: translateY(-4px);

            box-shadow:
                0 14px 40px rgba(0,0,0,0.45);
        }

        .page-title {

            font-size: 38px;

            font-weight: 700;
        }

        .custom-btn {

            border: none;

            border-radius: 12px;

            padding: 10px 18px;

            font-weight: 600;

            transition: 0.3s ease;
        }

        .custom-btn:hover {

            transform: translateY(-2px);
        }

        .btn-back {

            background: linear-gradient(
                135deg,
                #6b7280,
                #4b5563
            );

            color: white;
        }

        .btn-logout {

            background: linear-gradient(
                135deg,
                #ff5f6d,
                #d64550
            );

            color: white;
        }

        .btn-delete {

            background: linear-gradient(
                135deg,
                #ff5f6d,
                #d64550
            );

            color: white;

            border: none;

            border-radius: 10px;

            padding: 6px 14px;

            font-size: 14px;

            transition: 0.3s ease;
        }

        .btn-delete:hover {

            transform: scale(1.05);
        }

        .table-container {

            overflow-x: auto;
        }

        .custom-table {

            width: 100%;

            border-collapse: collapse;

            overflow: hidden;

            border-radius: 18px;

            margin-top: 20px;
        }

        .custom-table thead {

            background: rgba(0,0,0,0.45);
        }

        .custom-table th {

            padding: 16px;

            font-weight: 600;

            color: #ffffff;

            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .custom-table td {

            padding: 15px;

            color: #f3f4f6;

            border-bottom: 1px solid rgba(255,255,255,0.08);

            background: rgba(255,255,255,0.05);
        }

        .custom-table tbody tr {

            transition: 0.3s ease;
        }

        .custom-table tbody tr:hover {

            background: rgba(255,255,255,0.08);
        }

        .empty-alert {

            margin-top: 20px;

            background: rgba(255, 193, 7, 0.15);

            border: 1px solid rgba(255, 193, 7, 0.25);

            color: #ffe69c;

            padding: 18px;

            border-radius: 14px;
        }

        footer {

            margin-top: 35px;

            text-align: center;

            color: #f0f0f0;

            font-size: 14px;

            line-height: 1.8;
        }

        @media(max-width: 768px) {

            .page-title {

                font-size: 30px;
            }

            .top-bar {

                flex-direction: column;

                gap: 18px;

                align-items: flex-start !important;
            }

            .history-card {

                padding: 25px 18px;
            }
        }

    </style>

</head>

<body>

    <div class="container">

        <div class="history-card">

            <div class="d-flex justify-content-between align-items-center mb-4 top-bar">

                <h2 class="page-title">
                    Transaction History
                </h2>

                <div class="d-flex gap-2">

                    <a href="/dashboard" class="btn custom-btn btn-back">
                        Back
                    </a>

                    <a href="/logout" class="btn custom-btn btn-logout">
                        Logout
                    </a>

                </div>

            </div>

            <% if(transactions.length === 0){ %>

                <div class="empty-alert">

                    No transactions found.

                </div>

            <% } %>

            <div class="table-container">

                <table class="custom-table">

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Amount</th>

                            <th>Merchant</th>

                            <th>Txn Mode</th>

                            <th>Payment Mode</th>

                            <th>Date</th>

                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% transactions.forEach(txn => { %>

                            <tr>

                                <td>
                                    <%= txn.id %>
                                </td>

                                <td>
                                    ₹<%= txn.amount %>
                                </td>

                                <td>
                                    <%= txn.merchant %>
                                </td>

                                <td>
                                    <%= txn.txn_mode %>
                                </td>

                                <td>
                                    <%= txn.payment_mode %>
                                </td>

                                <td>
                                    <%= txn.created_at %>
                                </td>

                                <td>

                                    <form
                                        method="POST"
                                        action="/transaction/delete/<%= txn.id %>"
                                        onsubmit="return confirm('Delete this transaction?')"
                                    >

                                        <button class="btn-delete">

                                            Delete

                                        </button>

                                    </form>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

        <footer>

            <div>
                Developed by Saswat Mohapatra
            </div>

            <div>
                Please give your feedback at feedback_saswat@gmail.com
            </div>

        </footer>

    </div>

</body>

</html>