<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Transaction</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            font-family: 'Poppins', sans-serif;

            background:
                linear-gradient(
                    rgba(0, 0, 0, 0.65),
                    rgba(0, 0, 0, 0.75)
                ),
                url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?q=80&w=2070&auto=format&fit=crop');

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;

            min-height: 100vh;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            padding: 20px;
        }

        .transaction-card {

            width: 100%;
            max-width: 650px;

            background: rgba(255, 255, 255, 0.12);

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            border: 1px solid rgba(255,255,255,0.18);

            border-radius: 24px;

            padding: 40px;

            box-shadow:
                0 8px 32px rgba(0,0,0,0.35);

            color: white;

            transition: 0.35s ease;
        }

        .transaction-card:hover {

            transform: translateY(-5px);

            box-shadow:
                0 14px 40px rgba(0,0,0,0.45);
        }

        .page-title {

            font-size: 38px;

            font-weight: 700;

            text-align: center;

            margin-bottom: 10px;
        }

        .subtitle {

            text-align: center;

            margin-bottom: 35px;

            color: #e5e7eb;

            font-size: 15px;
        }

        .form-control,
        .form-select {

            height: 55px;

            border-radius: 14px;

            border: none;

            padding-left: 16px;

            font-size: 15px;

            margin-bottom: 18px;
        }

        .form-control:focus,
        .form-select:focus {

            box-shadow: 0 0 0 0.2rem rgba(79,124,255,0.35);
        }

        .btn-add {

            height: 55px;

            border-radius: 14px;

            font-weight: 600;

            font-size: 16px;

            border: none;

            background: linear-gradient(
                135deg,
                #34c759,
                #1e9e44
            );

            transition: 0.3s ease;
        }

        .btn-add:hover {

            transform: translateY(-2px);

            background: linear-gradient(
                135deg,
                #1e9e44,
                #34c759
            );
        }

        .analytics-card {

            margin-top: 35px;

            background: rgba(255,255,255,0.10);

            border: 1px solid rgba(255,255,255,0.12);

            border-radius: 20px;

            padding: 28px;

            backdrop-filter: blur(10px);
        }

        .analytics-title {

            font-size: 24px;

            font-weight: 600;

            margin-bottom: 20px;
        }

        .metric {

            margin-bottom: 14px;

            color: #f3f4f6;

            font-size: 15px;
        }

        .alert-box {

            margin-top: 12px;

            padding: 14px;

            border-radius: 12px;

            background: rgba(255, 0, 0, 0.15);

            border: 1px solid rgba(255, 0, 0, 0.25);

            color: #ffd6d6;
        }

        .suggestion-box {

            margin-top: 20px;

            padding: 18px;

            border-radius: 14px;

            background: rgba(79,124,255,0.15);

            border: 1px solid rgba(79,124,255,0.25);

            color: #e8f0ff;
        }

        footer {

            margin-top: 30px;

            text-align: center;

            color: #f0f0f0;

            font-size: 14px;

            line-height: 1.8;
        }

        @media(max-width: 576px) {

            .transaction-card {

                padding: 30px 22px;
            }

            .page-title {

                font-size: 30px;
            }
        }

    </style>

</head>

<body>

    <div class="transaction-card">

        <div class="page-title">
            Add Transaction
        </div>

        <div class="subtitle">
            Monitor and analyze your spending with SmartSpend AI
        </div>

        <form method="POST" action="/transaction">

            <input
                type="number"
                step="0.01"
                name="amount"
                class="form-control"
                placeholder="Transaction Amount"
                required
            >

            <input
                type="text"
                name="merchant"
                class="form-control"
                placeholder="Merchant Name"
                required
            >

            <select
                name="txn_mode"
                class="form-select"
            >

                <option>
                    UPI
                </option>

                <option>
                    Credit Card
                </option>

                <option>
                    Debit Card
                </option>

            </select>

            <select
                name="payment_mode"
                class="form-select"
            >

                <option>
                    Online
                </option>

                <option>
                    ATM
                </option>

                <option>
                    POS
                </option>

            </select>

            <button class="btn btn-success btn-add w-100">
                Add Transaction
            </button>

        </form>

        <% if(response){ %>

            <div class="analytics-card">

                <div class="analytics-title">
                    AI Analytics Dashboard
                </div>

                <div class="metric">
                    Remaining Limit:
                    <strong>
                        ₹<%= response.metrics.remaining %>
                    </strong>
                </div>

                <div class="metric">
                    Usage Percentage:
                    <strong>
                        <%= response.metrics.usage_percent %>%
                    </strong>
                </div>

                <div class="metric">
                    Average Daily Spend:
                    <strong>
                        ₹<%= response.metrics.avg_daily %>
                    </strong>
                </div>

                <div class="alert-box">
                    <%= response.metrics.alert %>
                </div>

                <div class="suggestion-box">

                    <h5 class="mb-3">
                        AI Suggestion
                    </h5>

                    <p class="mb-0">
                        <%= response.ai_suggestion %>
                    </p>

                </div>

            </div>

        <% } %>

    </div>

    <footer>

        <div>
            Developed by Saswat Mohapatra
        </div>

        <div>
            Please give your feedback at feedback_saswat@gmail.com
        </div>

    </footer>

</body>

</html>