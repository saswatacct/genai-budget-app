<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>

SmartSpend AI Login

</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<link
rel="preconnect"
href="https://fonts.googleapis.com"
>

<link
rel="preconnect"
href="https://fonts.gstatic.com"
crossorigin
>

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
rel="stylesheet"
>

<style>

*{

margin:0;

padding:0;

box-sizing:border-box;

}

body{

font-family:
'Poppins',
sans-serif;

background:

linear-gradient(

rgba(
0,
0,
0,
0.65
),

rgba(
0,
0,
0,
0.75
)

),

url(
'https://images.unsplash.com/photo-1554224155-6726b3ff858f?q=80&w=2070&auto=format&fit=crop'
);

background-size:cover;

background-position:center;

background-repeat:no-repeat;

min-height:100vh;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

padding:20px;

}

.login-card{

width:100%;

max-width:430px;

background:

rgba(
255,
255,
255,
0.12
);

backdrop-filter:
blur(14px);

-webkit-backdrop-filter:
blur(14px);

border:

1px solid
rgba(
255,
255,
255,
0.20
);

border-radius:24px;

padding:40px;

box-shadow:

0 8px 32px

rgba(
0,
0,
0,
0.35
);

color:white;

}

.login-title{

font-size:42px;

font-weight:700;

text-align:center;

margin-bottom:10px;

}

.subtitle{

text-align:center;

margin-bottom:35px;

color:#e4e4e4;

font-size:16px;

font-weight:300;

}

.form-control{

height:55px;

border-radius:14px;

border:none;

padding-left:16px;

font-size:15px;

margin-bottom:18px;

}

.form-control:focus{

box-shadow:

0 0 0 0.2rem

rgba(
13,
110,
253,
0.35
);

}

.btn-login{

height:55px;

border-radius:14px;

font-weight:600;

font-size:16px;

background:

linear-gradient(

135deg,

#4f7cff,

#2458ff

);

border:none;

transition:0.3s;

}

.btn-login:hover{

transform:

translateY(-2px);

background:

linear-gradient(

135deg,

#2458ff,

#4f7cff

);

}

.signup-link{

color:white;

text-decoration:none;

font-weight:500;

transition:0.3s;

}

.signup-link:hover{

color:#dbe7ff;

text-decoration:underline;

}

.forgot-link{

font-size:14px;

color:#9fc4ff;

text-decoration:none;

font-weight:500;

}

.forgot-link:hover{

color:white;

text-decoration:underline;

}

footer{

margin-top:28px;

text-align:center;

color:#f0f0f0;

font-size:14px;

line-height:1.8;

}

@media(
max-width:500px
){

.login-card{

padding:30px 24px;

}

.login-title{

font-size:34px;

}

.subtitle{

font-size:14px;

}

}

</style>

</head>

<body>

<div
class="login-card"
>

<div
class="login-title"
>

SmartSpend AI

</div>

<div
class="subtitle"
>

AI Powered Budget
&
Expense Tracking

</div>

<form
method="POST"
action="/login"
>

<input

type="email"

name="email"

class="form-control"

placeholder="Enter Email"

required

>

<input

type="password"

name="password"

class="form-control"

placeholder="Enter Password"

required

>

<div
class="text-end mb-3"
>

<a

href="/forgot-password"

class="forgot-link"

>

Forgot Password?

</a>

</div>

<button

class="btn btn-primary btn-login w-100"

>

Login

</button>

</form>

<div
class="text-center mt-4"
>

<a

href="/signup"

class="signup-link"

>

Create New Account

</a>

</div>

</div>

<footer>

<div>

Developed by
Saswat Mohapatra

</div>

<div>

Please give your feedback at

feedback_saswat@gmail.com

</div>

</footer>

</body>

</html>